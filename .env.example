# Copy this file to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Variables already set in
# the real environment take precedence over this file, so production can keep
# using systemd/EnvironmentFile without surprises.

# --- Google sign-in (required to turn authentication on) --------------------
#
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials
# -> OAuth client ID -> Application type: "Web application".
#
# Add this Authorised redirect URI (it must match exactly, including scheme,
# host, port and path):
#
#   http://localhost:3000/auth/google/callback
#
# Google only accepts plain HTTP for localhost / 127.0.0.1. Any other host
# (a WSL IP, a LAN address, a domain) must use HTTPS.
#
# No "Authorised JavaScript origin" is needed: the sign-in is a server-side
# redirect flow, not a browser popup.
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional ---------------------------------------------------------------

# The first account that signs in with this exact email is granted the admin
# role, but only while the instance has no active admin at all.
INITIAL_ADMIN_EMAIL=

# Public base URL, used to build the OAuth redirect. Leave unset to derive it
# from the incoming request (fine for local work, set it behind a proxy).
APP_BASE_URL=http://localhost:3000

# Session lifetime in days and the session cookie name.
#SESSION_TTL_DAYS=30
#SESSION_COOKIE_NAME=exam_session

# Local/testing only: use a different SQLite file.
#EXAM_SIMULATOR_DB=data/exam-simulator.db
